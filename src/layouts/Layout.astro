---
import '../styles/global.css';
import TopHeader from '../components/TopHeader.astro';
import MainHeader from '../components/MainHeader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "VALVOLINE PERÚ | Medidores de Agua, Saneamiento e Infraestructura",
  description = "Precisión en cada lectura, control en cada medición. Medidores de agua Woltman, Chorro Múltiple y Único en Hierro Dúctil."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-slate-900 font-['Inter',sans-serif] antialiased min-h-screen flex flex-col">
    <!-- 1. Top Header -->
    <TopHeader />

    <!-- 2. Main Header con buscador y logo -->
    <MainHeader />

    <!-- 3. Navegación Principal por Páginas -->
    <Navbar />

    <!-- 4. Contenido de la Página Actual -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- 5. Footer Institucional -->
    <Footer />
  </body>
</html>
