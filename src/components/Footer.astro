  <!-- SECCIÓN 2: Cuerpo Principal en 4 Columnas Estructuradas -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10">
      
      <!-- Columna 1 y 2: Identidad Institucional y Calidad Homologada -->
      <div class="lg:col-span-2 space-y-4">
        <!-- Logo en versión blanca limpia -->
        <a href="/" class="inline-block opacity-90 hover:opacity-100 transition-opacity" aria-label="Valvoline Perú">
          <img 
            src="/images/logo.svg" 
            alt="Valvoline Perú" 
            class="h-7 w-auto object-contain"
          />
        </a>

        <p class="text-slate-400 text-xs leading-relaxed max-w-sm">
          Especialistas en control de fluidos, macromedición y saneamiento. Proveemos equipos homologados bajo normas técnicas nacionales e internacionales para redes de distribución y proyectos de infraestructura en todo el Perú.
        </p>

        <!-- Certificaciones / Estándares con diseño sobrio en tonos neutros -->
        <div class="pt-2">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
            Homologación y Cumplimiento
          </span>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[10px] text-slate-300 font-medium">
              ISO 9001:2015
            </span>
            <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[10px] text-slate-300 font-medium">
              NTP / INACAL
            </span>
            <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[10px] text-slate-300 font-medium">
              SEDAPAL / EPS
            </span>
            <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[10px] text-slate-300 font-medium">
              SGS Certificado
            </span>
          </div>
        </div>

        <!-- Redes Sociales Minimalistas en escala de grises -->
        <div class="pt-2 flex items-center gap-2">
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-7 h-7 rounded-md bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white flex items-center justify-center transition-colors border border-white/5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.583 9 4.615V8z"/>
            </svg>
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-7 h-7 rounded-md bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white flex items-center justify-center transition-colors border border-white/5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="w-7 h-7 rounded-md bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white flex items-center justify-center transition-colors border border-white/5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 3: Catálogo de Líneas -->
      <div class="space-y-3">
        <h5 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Líneas de Productos
        </h5>
        <ul class="space-y-2 text-slate-400">
          <li>
            <a href="#productos" class="hover:text-slate-200 transition-colors inline-block">
              Válvulas en Hierro Dúctil
            </a>
          </li>
          <li>
            <a href="#productos" class="hover:text-slate-200 transition-colors inline-block">
              Medidores Chorro Múltiple
            </a>
          </li>
          <li>
            <a href="#productos" class="hover:text-slate-200 transition-colors inline-block">
              Macromedidores Woltman
            </a>
          </li>
          <li>
            <a href="#productos" class="hover:text-slate-200 transition-colors inline-block">
              Válvulas & Llaves en Bronce
            </a>
          </li>
          <li>
            <a href="#productos" class="hover:text-slate-200 transition-colors inline-block">
              Conexiones & Juntas Bridadas
            </a>
          </li>
          <li>
            <a href="#productos" class="hover:text-slate-200 transition-colors inline-block">
              Líneas PVC & HDPE
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Documentación y Servicios -->
      <div class="space-y-3">
        <h5 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Servicios y Soporte
        </h5>
        <ul class="space-y-2 text-slate-400">
          <li>
            <a href="#contacto" class="hover:text-slate-200 transition-colors inline-block">
              Descarga de Catálogo Técnico
            </a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-slate-200 transition-colors inline-block">
              Certificados de Calibración
            </a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-slate-200 transition-colors inline-block">
              Asesoría en Licitaciones
            </a>
          </li>
          <li>
            <a href="#ofertas" class="hover:text-slate-200 transition-colors inline-block">
              Promociones y Descuentos
            </a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-slate-200 transition-colors inline-block">
              Envíos Nacionales y Exportación
            </a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-slate-200 transition-colors inline-block">
              Garantía y Servicio Postventa
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 5: Ubicación y Horarios de Atención -->
      <div class="space-y-3">
        <h5 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Atención y Despacho
        </h5>
        
        <div class="space-y-2.5 text-slate-400 text-xs">
          <div>
            <span class="block text-[11px] text-slate-300 font-semibold">Almacén Central:</span>
            <span>Lima Metropolitana, Perú</span>
          </div>

          <div>
            <span class="block text-[11px] text-slate-300 font-semibold">Horario de Oficina:</span>
            <span>Lun - Vie: 8:00 AM - 6:00 PM</span>
            <span class="block text-slate-400">Sáb: 8:30 AM - 1:00 PM</span>
          </div>

          <div>
            <span class="block text-[11px] text-slate-300 font-semibold">Teléfonos de Ventas:</span>
            <a href="tel:926961256" class="hover:text-slate-200 transition-colors">926 961 256</a>
            <span class="text-slate-600">/</span>
            <a href="tel:974509023" class="hover:text-slate-200 transition-colors">974 509 023</a>
          </div>

          <!-- Libro de Reclamaciones sobrio -->
          <div class="pt-2">
            <a
              href="#contacto"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-white/5 hover:bg-white/10 border border-white/5 text-[11px] text-slate-300 hover:text-white transition-colors cursor-pointer"
            >
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
