  <!-- SECCIÓN 3: Barra Inferior / Legal, Derechos y Copyright (Gris Pizarra Muy Oscuro) -->
  <div class="bg-[#090d14] border-t border-white/5 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-400">
      
      <div>
        <p>© {new Date().getFullYear()} Valvoline Perú. Todos los derechos reservados.</p>
      </div>

      <div class="flex items-center gap-4 text-slate-400">
        <a href="#inicio" class="hover:text-slate-300 transition-colors">Términos de Uso</a>
        <span>•</span>
        <a href="#inicio" class="hover:text-slate-300 transition-colors">Política de Privacidad</a>
        <span>•</span>
        <a href="#contacto" class="hover:text-slate-300 transition-colors">Contacto</a>
      </div>

    </div>
  </div>

</footer>
