---
// Navbar.astro - Barra de navegación centrada, compacta con menú desplegable en "Productos"
interface SubItem {
  name: string;
  href: string;
}

interface NavItem {
  name: string;
  href: string;
  submenu?: SubItem[];
}

const productCategories: SubItem[] = [
  { name: "Conexiones Bridadas Hierro Dúctil", href: "/productos?categoria=conexiones-bridadas" },
  { name: "Válvulas en Hierro Dúctil", href: "/productos?categoria=valvulas-hierro-ductil" },
  { name: "Línea PVC ERA", href: "/productos?categoria=linea-pvc-era" },
  { name: "Línea Bronce", href: "/productos?categoria=linea-bronce" },
  { name: "Línea HDPE", href: "/productos?categoria=linea-hdpe" },
  { name: "Marca MAPACHE", href: "/productos?categoria=marca-mapache" },
  { name: "Medidores de Agua", href: "/productos?categoria=medidores" },
];

const navItems: NavItem[] = [
  { name: "Inicio", href: "/" },
  { name: "Nosotros", href: "/nosotros" },
  { 
    name: "Productos", 
    href: "/productos",
    submenu: productCategories
  },
  { name: "Contáctanos", href: "/contacto" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === "/") {
    return currentPath === "/" || currentPath === "";
  }
  return currentPath.startsWith(href);
};
---

<nav class="bg-[#010101] text-white border-b border-white/10 shadow-sm select-none sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Contenedor centrado y compacto (h-10) -->
    <div class="flex items-center justify-center h-10 relative">
      
      <!-- Enlaces de Navegación Centrados con fuente reducida (text-xs / text-[11px]) -->
      <div class="hidden sm:flex items-center justify-center gap-6 md:gap-10">
        {navItems.map((item) => {
          const active = isCurrent(item.href);
          return item.submenu ? (
            /* Elemento con Menú Desplegable (Productos) */
            <div class="relative group h-10 flex items-center cursor-pointer">
              <a
                href={item.href}
                class={`relative py-2 px-2 text-[11px] sm:text-xs font-semibold uppercase tracking-wider transition-colors duration-200 flex items-center gap-1.5 ${
                  active ? "text-[#ffcc00]" : "text-neutral-300 group-hover:text-[#ffcc00]"
                }`}
              >
                <span>{item.name}</span>
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180 text-neutral-400 group-hover:text-[#ffcc00]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
                
                <!-- Línea indicadora inferior en hover o activa -->
                <span 
                  class={`absolute bottom-0 left-0 right-0 h-[2px] bg-[#ffcc00] transition-transform duration-200 ${
                    active ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"
                  }`}
                />
              </a>

              <!-- Panel Desplegable (Dropdown) -->
              <div class="absolute top-10 left-1/2 -translate-x-1/2 w-64 bg-[#0a0a0a] border border-white/10 rounded-b-lg shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                
                <!-- Borde superior tricolor sutil -->
                <div class="h-0.5 w-full flex mb-1">
                  <div class="w-1/3 bg-[#dd0000]"></div>
                  <div class="w-1/3 bg-[#ffcc00]"></div>
                  <div class="w-1/3 bg-[#010101]"></div>
                </div>

                {item.submenu.map((sub) => (
                  <a
                    href={sub.href}
                    class="block px-4 py-2 text-[11px] font-medium text-neutral-300 hover:text-white hover:bg-neutral-900/80 transition-colors border-l-2 border-transparent hover:border-[#dd0000] flex items-center justify-between group/item"
                  >
                    <span>{sub.name}</span>
                    <svg class="w-3 h-3 text-neutral-600 group-hover/item:text-[#ffcc00] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            /* Elementos regulares de navegación */
            <a
              href={item.href}
              class={`relative py-2 px-2 text-[11px] sm:text-xs font-semibold uppercase tracking-wider transition-colors duration-200 group flex items-center ${
                active ? "text-[#ffcc00]" : "text-neutral-300 hover:text-[#ffcc00]"
              }`}
            >
              <span>{item.name}</span>
              <span 
                class={`absolute bottom-0 left-0 right-0 h-[2px] bg-[#ffcc00] transition-transform duration-200 ${
                  active ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"
                }`}
              />
            </a>
          );
        })}
      </div>

      <!-- Botón móvil para pantallas pequeñas -->
      <div class="flex sm:hidden absolute right-0">
        <button 
          id="navbar-toggle-btn" 
          type="button" 
          class="text-neutral-200 hover:text-white p-1 rounded-md hover:bg-white/10 cursor-pointer"
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Menú desplegable para móviles -->
  <div id="navbar-mobile-menu" class="hidden sm:hidden bg-[#0a0a0a] border-t border-white/10 px-4 pt-2 pb-3 space-y-1">
    {navItems.map((item) => {
      const active = isCurrent(item.href);
      return item.submenu ? (
        <div class="space-y-1">
          <button
            type="button"
            id="mobile-submenu-toggle"
            class="w-full text-left py-1.5 px-3 text-[11px] font-semibold uppercase tracking-wider text-neutral-200 hover:text-white flex items-center justify-between cursor-pointer"
          >
            <span>{item.name}</span>
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="mobile-submenu" class="hidden pl-4 space-y-1 border-l border-white/10 ml-3">
            {item.submenu.map((sub) => (
              <a
                href={sub.href}
                class="block py-1 px-2 text-[10px] text-neutral-400 hover:text-[#ffcc00]"
              >
                {sub.name}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class={`block py-1.5 px-3 text-[11px] font-semibold uppercase tracking-wider rounded-md ${
            active 
              ? "bg-[#ffcc00]/10 text-[#ffcc00]" 
              : "text-neutral-200 hover:bg-white/5 hover:text-white"
          }`}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById('navbar-toggle-btn');
  const mobileMenu = document.getElementById('navbar-mobile-menu');
  const mobileSubmenuBtn = document.getElementById('mobile-submenu-toggle');
  const mobileSubmenu = document.getElementById('mobile-submenu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  if (mobileSubmenuBtn && mobileSubmenu) {
    mobileSubmenuBtn.addEventListener('click', () => {
      mobileSubmenu.classList.toggle('hidden');
    });
  }
</script>
