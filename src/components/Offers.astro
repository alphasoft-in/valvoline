---
// Offers.astro - Sección moderna e interactiva de ofertas industriales Valvoline Perú
interface OfferProduct {
  id: string;
  category: "all" | "medidores" | "valvulas" | "bronce";
  categoryLabel: string;
  title: string;
  code: string;
  specs: string;
  badge: string;
  badgeColor?: "red" | "yellow";
  originalPrice: string;
  offerPrice: string;
  discount: string;
  stockText: string;
  image: string;
  imageAlt: string;
  whatsappMessage: string;
}

const offers: OfferProduct[] = [
  {
    id: "med-01",
    category: "medidores",
    categoryLabel: "Medición Domiciliaria",
    title: "Medidor de Agua Chorro Múltiple R160",
    code: "VAL-MJ15/20",
    specs: "Cuerpo en Hierro Dúctil / Latón • DN 15mm y 20mm (1/2\" y 3/4\") • Certificación Homologada SEDAPAL / EPS",
    badge: "OFERTA POR LOTE",
    badgeColor: "red",
    discount: "-20%",
    originalPrice: "S/ 145.00",
    offerPrice: "S/ 115.00",
    stockText: "Stock: +1,500 unid. disponibles",
    image: "/images/multijet_meter.jpg",
    imageAlt: "Medidor de agua chorro múltiple Valvoline Perú",
    whatsappMessage: "Hola, deseo cotizar la oferta del Medidor de Agua Chorro Múltiple R160 (VAL-MJ15/20)"
  },
  {
    id: "med-02",
    category: "medidores",
    categoryLabel: "Macromedición",
    title: "Macromedidor Woltman Tipo WP-Dynamic",
    code: "VAL-WLT-DN",
    specs: "Bridas DIN / ANSI • DN 50mm a 200mm (2\" a 8\") • PN16 • Predispuesto para telemetría con salida de pulsos",
    badge: "ENVÍO GRATIS LIMA",
    badgeColor: "yellow",
    discount: "-15%",
    originalPrice: "S/ 890.00",
    offerPrice: "S/ 749.00",
    stockText: "Stock para entrega inmediata",
    image: "/images/woltman_meter.jpg",
    imageAlt: "Macromedidor Woltman Valvoline Perú",
    whatsappMessage: "Hola, deseo cotizar la oferta del Macromedidor Woltman WP-Dynamic (VAL-WLT-DN)"
  },
  {
    id: "valv-01",
    category: "valvulas",
    categoryLabel: "Línea Matriz Redes",
    title: "Válvula de Compuerta Cierre Elástico PN16",
    code: "VAL-VCE-HD",
    specs: "Hierro Dúctil GGG50 • Eje en Acero Inoxidable • Vástago no ascendente • Pintura epóxica atóxica 250 µm",
    badge: "PRECIO PROYECTO",
    badgeColor: "red",
    discount: "-25%",
    originalPrice: "S/ 390.00",
    offerPrice: "S/ 295.00",
    stockText: "Certificado de calidad ISO/SGS",
    image: "/images/slide-1.png",
    imageAlt: "Válvula de compuerta en hierro dúctil Valvoline Perú",
    whatsappMessage: "Hola, deseo cotizar la oferta de la Válvula de Compuerta Cierre Elástico (VAL-VCE-HD)"
  },
  {
    id: "bronce-01",
    category: "bronce",
    categoryLabel: "Accesorios & Conexiones",
    title: "Pack Válvulas y Llaves de Paso en Bronce",
    code: "VAL-KIT-BRZ",
    specs: "Bronce forjado de alta densidad • Esféricas, retención y paso rápido • Roscas NPT / ISO • Presión 600 WOG",
    badge: "COMBO INSTALADOR",
    badgeColor: "yellow",
    discount: "-30%",
    originalPrice: "S/ 180.00",
    offerPrice: "S/ 126.00",
    stockText: "Garantía de fábrica 2 años",
    image: "/images/slide-2.png",
    imageAlt: "Línea en bronce Valvoline Perú",
    whatsappMessage: "Hola, deseo cotizar el Combo de Válvulas de Bronce (VAL-KIT-BRZ)"
  }
];

const categories = [
  { id: "all", label: "Todas las Ofertas" },
  { id: "medidores", label: "Medidores de Agua" },
  { id: "valvulas", label: "Válvulas en Hierro Dúctil" },
  { id: "bronce", label: "Línea Bronce" },
];
---

<section id="ofertas" class="relative py-12 sm:py-16 bg-neutral-100/60 border-b border-neutral-200 select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 sm:mb-10">
      <div>
        <!-- Kicker corporativo con icono de oferta -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#dd0000]/10 border border-[#dd0000]/20 text-[#dd0000] text-xs font-black uppercase tracking-wider mb-2.5">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.75 2.75a.75.75 0 00-1.5 0v1.5a.75.75 0 001.5 0v-1.5zM6.343 4.93a.75.75 0 00-1.06 1.06l1.06 1.06a.75.75 0 001.061-1.06L6.343 4.93zM18.718 6.05a.75.75 0 00-1.061-1.06l-1.06 1.06a.75.75 0 001.06 1.06l1.061-1.06zM3.75 11.25a.75.75 0 000 1.5h1.5a.75.75 0 000-1.5h-1.5zM18.75 11.25a.75.75 0 000 1.5h1.5a.75.75 0 000-1.5h-1.5zM7.404 16.596a.75.75 0 00-1.06-1.06l-1.061 1.06a.75.75 0 001.06 1.061l1.06-1.061zM17.657 15.536a.75.75 0 00-1.06 1.06l1.06 1.061a.75.75 0 001.061-1.06l-1.06-1.061zM12 7.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9z"/>
          </svg>
          <span>Promociones del Mes • Stock Inmediato</span>
        </div>
        
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#010101] tracking-tight uppercase leading-tight">
          Ofertas Especiales en <span class="text-[#dd0000]">Medición & Válvulas</span>
        </h2>
        <p class="text-xs sm:text-sm text-neutral-600 mt-2 max-w-2xl font-normal leading-relaxed">
          Precios preferenciales por volumen para empresas de agua, contratistas, constructoras y distribuidoras. Homologación garantizada y soporte técnico de fábrica.
        </p>
      </div>

      <!-- Filtros por Categoría Interactivos -->
      <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap" id="offer-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat.id}
            class={`offer-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer ${
              idx === 0 
                ? "bg-[#010101] text-white shadow-sm" 
                : "bg-white text-neutral-700 hover:bg-neutral-200/70 border border-neutral-200"
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Grid de Ofertas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="offers-grid">
      {offers.map((item) => (
        <article 
          class="offer-card group bg-white border border-neutral-200 rounded-xl overflow-hidden shadow-sm hover:shadow-xl hover:border-[#dd0000] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
          data-category={item.category}
        >
          <!-- Parte Superior: Etiquetas y Foto de Producto -->
          <div class="relative bg-neutral-50 border-b border-neutral-100 p-4 flex flex-col items-center justify-center min-h-[200px]">
            <!-- Badges Superiores -->
            <div class="absolute top-3 left-3 flex flex-col gap-1 z-10 items-start">
              <span class={`text-[10px] font-black uppercase px-2.5 py-0.5 rounded shadow-xs tracking-wider ${
                item.badgeColor === "yellow" 
                  ? "bg-[#ffcc00] text-[#010101]" 
                  : "bg-[#dd0000] text-white"
              }`}>
                {item.badge}
              </span>
              <span class="bg-[#010101] text-white font-black text-[11px] px-2 py-0.5 rounded shadow-xs">
                {item.discount}
              </span>
            </div>

            <!-- Código de Producto sutil a la derecha -->
            <span class="absolute top-3 right-3 text-[10px] font-bold text-neutral-400 bg-white/80 px-1.5 py-0.5 rounded border border-neutral-200">
              {item.code}
            </span>

            <!-- Imagen del Producto -->
            <div class="w-full h-40 flex items-center justify-center overflow-hidden my-2">
              <img 
                src={item.image} 
                alt={item.imageAlt}
                class="max-h-full max-w-full object-contain group-hover:scale-108 transition-transform duration-300"
                loading="lazy"
              />
            </div>

            <!-- Disponibilidad de Stock -->
            <div class="w-full flex items-center justify-center gap-1.5 text-[10px] text-emerald-700 font-semibold mt-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>{item.stockText}</span>
            </div>
          </div>

          <!-- Cuerpo de la Tarjeta -->
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-black uppercase tracking-wider text-[#dd0000] block mb-1">
                {item.categoryLabel}
              </span>
              <h3 class="text-sm font-black text-[#010101] tracking-tight uppercase leading-snug group-hover:text-[#dd0000] transition-colors mb-2">
                {item.title}
              </h3>
              <p class="text-[11px] text-neutral-600 font-normal leading-relaxed line-clamp-3 mb-4">
                {item.specs}
              </p>
            </div>

            <!-- Precios y Acciones -->
            <div class="pt-3 border-t border-neutral-100">
              <!-- Bloque de Precio -->
              <div class="flex items-baseline justify-between mb-3.5">
                <div>
                  <span class="text-[10px] text-neutral-400 line-through block font-medium">
                    Antes {item.originalPrice}
                  </span>
                  <div class="flex items-baseline gap-1">
                    <span class="text-base sm:text-lg font-black text-[#dd0000] tracking-tight">
                      {item.offerPrice}
                    </span>
                    <span class="text-[10px] font-bold text-neutral-500 uppercase">+ IGV</span>
                  </div>
                </div>

                <div class="text-right">
                  <span class="text-[9px] uppercase font-bold text-neutral-400 block">Precios por Mayor</span>
                  <span class="text-[10px] font-extrabold text-[#010101]">Consultar Lote</span>
                </div>
              </div>

              <!-- Botones de Acción -->
              <div class="flex flex-col gap-2">
                <!-- Botón de Cotización por WhatsApp -->
                <a
                  href={`https://wa.me/51926961256?text=${encodeURIComponent(item.whatsappMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full bg-[#ffcc00] hover:bg-[#f0be00] text-[#010101] font-black text-xs uppercase tracking-wide py-2.5 px-3 rounded-lg flex items-center justify-center gap-2 transition-all shadow-xs hover:shadow-md cursor-pointer"
                >
                  <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  <span>Cotizar Oferta</span>
                </a>

                <!-- Enlace secundario directo para detalles -->
                <a
                  href="#contacto"
                  class="w-full bg-white hover:bg-neutral-50 text-neutral-700 hover:text-[#dd0000] border border-neutral-200 font-bold text-[11px] py-1.5 px-3 rounded-lg flex items-center justify-center transition-colors cursor-pointer"
                >
                  <span>Ficha Técnica y Detalles</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Banner Inferior de Cotización Rápida y Requerimientos de Proyecto -->
    <div class="mt-12 bg-gradient-to-r from-[#010101] via-[#1a1a1a] to-[#010101] text-white rounded-2xl p-6 sm:p-8 border border-neutral-800 shadow-xl flex flex-col lg:flex-row items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-[#dd0000] text-white flex items-center justify-center shrink-0 shadow-md">
          <svg class="w-6 h-6 stroke-[2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <div>
          <span class="text-[10px] font-black uppercase tracking-widest text-[#ffcc00] block mb-1">
            Atención Especial a Obras y Licitaciones
          </span>
          <h4 class="text-base sm:text-lg font-black tracking-tight uppercase text-white">
            ¿Tienes una lista de materiales o expediente técnico?
          </h4>
          <p class="text-xs text-neutral-300 font-normal mt-1 max-w-2xl leading-relaxed">
            Envíanos tus metrados y especificaciones. Elaboramos tu presupuesto formal con descuentos escalonados y certificados de calibración en menos de 2 horas.
          </p>
        </div>
      </div>

      <!-- Botones de Acción del Banner -->
      <div class="flex items-center gap-3 w-full lg:w-auto shrink-0 flex-col sm:flex-row">
        <a 
          href="https://wa.me/51926961256?text=Hola,%20tengo%20una%20lista%20de%20materiales%20para%20cotizar" 
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-3 bg-[#dd0000] hover:bg-[#b80000] text-white font-black text-xs uppercase tracking-wider rounded-lg transition-all duration-200 text-center shadow-md hover:shadow-lg cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Enviar Lista por WhatsApp</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
          </svg>
        </a>
        <a 
          href="tel:926961256" 
          class="w-full sm:w-auto px-5 py-3 bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider rounded-lg transition-colors text-center border border-white/20 cursor-pointer"
        >
          Llamar: 926 961 256
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Script interactivo de filtrado de categorías sin recarga -->
<script>
  function setupOfferFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.offer-filter-btn');
    const offerCards = document.querySelectorAll<HTMLElement>('.offer-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const selectedFilter = btn.dataset.filter;

        // Estilos de botones activos
        filterButtons.forEach(b => {
          b.classList.remove('bg-[#010101]', 'text-white', 'shadow-sm');
          b.classList.add('bg-white', 'text-neutral-700', 'border', 'border-neutral-200');
        });
        btn.classList.remove('bg-white', 'text-neutral-700', 'border', 'border-neutral-200');
        btn.classList.add('bg-[#010101]', 'text-white', 'shadow-sm');

        // Filtrar tarjetas
        offerCards.forEach(card => {
          const cardCategory = card.dataset.category;
          if (selectedFilter === 'all' || cardCategory === selectedFilter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  // Inicializar al cargar el documento
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupOfferFilters);
  } else {
    setupOfferFilters();
  }
</script>
