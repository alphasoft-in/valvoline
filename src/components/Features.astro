---
// Features.astro - Sección corporativa de 4 pilares de confianza y valor industrial Valvoline Perú
interface FeatureItem {
  kicker: string;
  title: string;
  description: string;
  icon: string;
}

const features: FeatureItem[] = [
  {
    kicker: "CALIDAD HOMOLOGADA",
    title: "Productos Certificados",
    description: "Bajo normas nacionales e internacionales.",
    icon: "shield"
  },
  {
    kicker: "SOPORTE TÉCNICO",
    title: "Asesoría Permanente",
    description: "Contamos con un staff de técnicos especialistas.",
    icon: "headset"
  },
  {
    kicker: "COBERTURA INTEGRAL",
    title: "Envíos a Nivel Nacional",
    description: "Realizamos envíos a todo el Perú y también Ecuador y Bolivia.",
    icon: "truck"
  },
  {
    kicker: "DISPONIBILIDAD INMEDIATA",
    title: "Stock Permanente",
    description: "Stock permanente para entrega inmediata.",
    icon: "warehouse"
  }
];
---

<section class="relative bg-white border-b border-neutral-200 select-none">
  <!-- Borde superior tricolor corporativo -->
  <div class="h-1 w-full flex">
    <div class="w-1/3 bg-[#dd0000]"></div>
    <div class="w-1/3 bg-[#ffcc00]"></div>
    <div class="w-1/3 bg-[#010101]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200">
      {features.map((item) => (
        <div class="group p-6 lg:p-7 flex flex-col justify-between transition-all duration-300 hover:bg-neutral-50/80">
          <div>
            <!-- Cabecera con Icono Industrial y Textos -->
            <div class="flex items-start gap-4 mb-3">
              <div class="w-12 h-12 rounded-lg bg-[#010101] group-hover:bg-[#dd0000] text-white flex items-center justify-center shrink-0 shadow-sm transition-colors duration-300">
                {item.icon === "shield" && (
                  <svg class="w-6 h-6 stroke-[1.75]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                  </svg>
                )}
                {item.icon === "headset" && (
                  <svg class="w-6 h-6 stroke-[1.75]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
                  </svg>
                )}
                {item.icon === "truck" && (
                  <svg class="w-6 h-6 stroke-[1.75]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25H4.125c-.621 0-1.125.504-1.125 1.125V14.25m11.25-6.75v11.25m0-11.25h2.25" />
                  </svg>
                )}
                {item.icon === "warehouse" && (
                  <svg class="w-6 h-6 stroke-[1.75]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                  </svg>
                )}
              </div>

              <div>
                <span class="text-[10px] font-black text-[#dd0000] tracking-widest uppercase block mb-0.5">
                  {item.kicker}
                </span>
                <h4 class="text-xs sm:text-sm font-black text-[#010101] tracking-tight uppercase leading-tight group-hover:text-[#dd0000] transition-colors">
                  {item.title}
                </h4>
              </div>
            </div>

            <!-- Descripción -->
            <p class="text-xs text-neutral-600 font-normal leading-relaxed pl-1 sm:pl-0">
              {item.description}
            </p>
          </div>

          <!-- Línea indicadora inferior decorativa en hover -->
          <div class="h-0.5 w-0 group-hover:w-full bg-[#dd0000] transition-all duration-300 mt-4"></div>
        </div>
      ))}
    </div>
  </div>
</section>
