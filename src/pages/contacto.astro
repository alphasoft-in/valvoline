---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contáctanos | VALVOLINE PERÚ - Cotizaciones y Asesoría Técnica de Saneamiento"
  description="Contacta con el equipo comercial y técnico de Valvoline Perú. Solicita cotizaciones formales para licitaciones, metrados de obras y compras corporativas."
>
  <!-- Encabezado de la Página de Contacto -->
  <section class="bg-gradient-to-b from-slate-100 via-white to-slate-50 text-slate-900 py-12 sm:py-16 border-b border-neutral-200 select-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100/80 border border-red-200 text-[#dd0000] text-xs font-semibold uppercase tracking-wider mb-2.5">
          <span>Canal de Atención Directa</span>
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 mb-2">
          Cotizaciones & <span class="text-[#dd0000]">Contacto</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
          Atendemos requerimientos para proyectos de agua potable, alcantarillado, redes de distribución y obras en todo el país.
        </p>
      </div>
    </div>
  </section>

  <!-- Contenido Principal: Formulario e Información -->
  <section class="py-12 sm:py-16 bg-neutral-50/70 border-b border-neutral-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Formulario de Cotización B2B (Columna Izquierda 7 cols) -->
        <div class="lg:col-span-7 bg-white p-6 sm:p-8 rounded-2xl border border-neutral-200 shadow-2xs">
          <div class="mb-6">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-[#dd0000] block mb-1">
              Presupuesto Rápido
            </span>
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug">
              Solicitar Cotización Formal
            </h2>
            <p class="text-xs text-neutral-500 mt-1 font-normal">
              Completa el formulario y un asesor comercial te responderá en menos de 2 horas.
            </p>
          </div>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1">
                  Nombre Completo *
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="nombre" 
                  required 
                  placeholder="Ej. Ing. Carlos Mendoza" 
                  class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-[#dd0000] bg-neutral-50/50"
                />
              </div>

              <div>
                <label for="contact-company" class="block text-xs font-semibold text-slate-700 mb-1">
                  Empresa / RUC *
                </label>
                <input 
                  type="text" 
                  id="contact-company" 
                  name="empresa" 
                  required 
                  placeholder="Ej. Consorcio Saneamiento / RUC" 
                  class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-[#dd0000] bg-neutral-50/50"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-phone" class="block text-xs font-semibold text-slate-700 mb-1">
                  Teléfono / WhatsApp *
                </label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="telefono" 
                  required 
                  placeholder="Ej. 987 654 321" 
                  class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-[#dd0000] bg-neutral-50/50"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-semibold text-slate-700 mb-1">
                  Correo Electrónico *
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="correo" 
                  required 
                  placeholder="Ej. compras@empresa.com" 
                  class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-[#dd0000] bg-neutral-50/50"
                />
              </div>
            </div>

            <div>
              <label for="contact-category" class="block text-xs font-semibold text-slate-700 mb-1">
                Línea de Interés Principal
              </label>
              <select 
                id="contact-category" 
                name="linea" 
                class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-[#dd0000] bg-neutral-50/50"
              >
                <option value="medidores">Medidores de Agua (Chorro Múltiple / Woltman)</option>
                <option value="valvulas">Válvulas en Hierro Dúctil (Compuerta / Mariposa / Check)</option>
                <option value="conexiones">Conexiones Bridadas y Juntas de Desmontaje</option>
                <option value="bronce">Línea Bronce y Acometidas</option>
                <option value="hdpe">Línea HDPE Termofusión y Electrofusión</option>
                <option value="licitacion">Expediente Técnico / Licitación Completa</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-slate-700 mb-1">
                Detalle de Requerimiento / Metrados *
              </label>
              <textarea 
                id="contact-message" 
                name="mensaje" 
                rows="4" 
                required 
                placeholder="Especifica los diámetros, cantidades aproximadas o adjunta tu lista de materiales..." 
                class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-[#dd0000] bg-neutral-50/50"
              ></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <button 
                type="submit" 
                class="flex-1 bg-[#dd0000] hover:bg-[#b80000] text-white font-semibold text-xs tracking-normal py-2.5 px-5 rounded-lg transition-colors cursor-pointer shadow-xs hover:shadow-md"
              >
                Enviar Solicitud de Cotización
              </button>

              <button 
                type="button" 
                id="whatsapp-direct-btn" 
                class="bg-[#ffcc00] hover:bg-[#f0be00] text-[#010101] font-semibold text-xs tracking-normal py-2.5 px-5 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-xs hover:shadow-md"
              >
                <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Cotizar por WhatsApp</span>
              </button>
            </div>
            
            <p id="form-success-alert" class="hidden text-xs text-emerald-700 bg-emerald-50 p-3 rounded-lg border border-emerald-200 font-medium">
              ¡Tu mensaje ha sido recibido! Un asesor técnico se comunicará contigo a la brevedad.
            </p>
          </form>
        </div>

        <!-- Canales e Información Directa (Columna Derecha 5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Tarjeta de Teléfonos y WhatsApp -->
          <div class="bg-white p-6 rounded-2xl border border-neutral-200 shadow-2xs">
            <h3 class="text-xs sm:text-sm font-bold text-slate-800 tracking-normal mb-4 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#dd0000]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Teléfonos Directos de Ventas</span>
            </h3>

            <div class="space-y-3 text-xs font-normal">
              <div class="flex items-center justify-between p-3 rounded-xl bg-neutral-50 border border-neutral-100">
                <div>
                  <span class="block text-[10px] text-neutral-400 font-medium">Línea Principal / WhatsApp</span>
                  <a href="tel:926961256" class="text-sm font-semibold text-slate-800 hover:text-[#dd0000]">926 961 256</a>
                </div>
                <a href="https://wa.me/51926961256" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded font-medium text-[10px]">
                  Chat
                </a>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl bg-neutral-50 border border-neutral-100">
                <div>
                  <span class="block text-[10px] text-neutral-400 font-medium">Línea Técnica / Cotizaciones</span>
                  <a href="tel:974509023" class="text-sm font-semibold text-slate-800 hover:text-[#dd0000]">974 509 023</a>
                </div>
                <a href="https://wa.me/51974509023" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded font-medium text-[10px]">
                  Chat
                </a>
              </div>
            </div>
          </div>

          <!-- Correo y Almacén -->
          <div class="bg-white p-6 rounded-2xl border border-neutral-200 shadow-2xs space-y-4 text-xs font-normal">
            <div>
              <span class="text-[10px] font-medium text-neutral-400 block mb-0.5">Correo para Expedientes y Licitaciones</span>
              <a href="mailto:ventas@valvoline-peru.com" class="text-xs sm:text-sm font-semibold text-slate-800 hover:text-[#dd0000] transition-colors">
                ventas@valvoline-peru.com
              </a>
            </div>

            <div class="pt-3 border-t border-neutral-100">
              <span class="text-[10px] font-medium text-neutral-400 block mb-0.5">Almacén Central y Despacho</span>
              <p class="text-slate-600 leading-relaxed text-xs">
                Lima Metropolitana, Perú.<br/>
                Envíos diarios a agencias de transporte hacia todo el Perú, Ecuador y Bolivia.
              </p>
            </div>

            <div class="pt-3 border-t border-neutral-100">
              <span class="text-[10px] font-medium text-neutral-400 block mb-0.5">Horario de Atención</span>
              <p class="text-slate-600 leading-relaxed text-xs">
                Lunes a Viernes: 8:00 AM – 6:00 PM<br/>
                Sábados: 8:30 AM – 1:00 PM
              </p>
            </div>
          </div>

          <!-- Libro de Reclamaciones -->
          <div id="libro-de-reclamaciones" class="bg-neutral-100/80 p-4 rounded-2xl border border-neutral-200 text-xs flex items-center justify-between gap-4">
            <div>
              <h4 class="font-semibold text-slate-800 text-xs">Libro de Reclamaciones</h4>
              <p class="text-[11px] text-neutral-500 mt-0.5 font-normal">Conforme a lo establecido en el Código de Protección y Defensa del Consumidor.</p>
            </div>
            <a 
              href="mailto:ventas@valvoline-peru.com?subject=Reclamo%20-%20Libro%20de%20Reclamaciones" 
              class="px-3 py-1.5 rounded-lg bg-white hover:bg-neutral-200 border border-neutral-300 text-slate-700 font-medium text-[11px] shrink-0 transition-colors cursor-pointer"
            >
              Registrar
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const whatsappBtn = document.getElementById('whatsapp-direct-btn');
    const successAlert = document.getElementById('form-success-alert');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (successAlert) {
          successAlert.classList.remove('hidden');
        }
        form.reset();
      });
    }

    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', () => {
        const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
        const companyInput = document.getElementById('contact-company') as HTMLInputElement | null;
        const msgInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

        const name = nameInput ? nameInput.value.trim() : '';
        const company = companyInput ? companyInput.value.trim() : '';
        const msg = msgInput ? msgInput.value.trim() : '';

        const text = `Hola Valvoline Perú, soy ${name || 'un cliente'} de la empresa ${company || 'en Perú'}. Deseo cotizar: ${msg || 'Equipos de saneamiento y medición'}.`;
        window.open(`https://wa.me/51926961256?text=${encodeURIComponent(text)}`, '_blank');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
</script>
