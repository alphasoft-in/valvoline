---

<Layout
  title="Catálogo de Productos | VALVOLINE PERÚ - Válvulas y Medidores de Agua"
  description="Catálogo técnico de válvulas en hierro dúctil, medidores de agua Woltman y chorro múltiple, conexiones bridadas y accesorios en bronce."
>
  <!-- Encabezado de la Página -->
  <!-- Encabezado de la Página de Catálogo -->
  <section class="bg-gradient-to-b from-slate-100 via-white to-slate-50 text-slate-900 py-12 sm:py-16 border-b border-neutral-200 select-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100/80 border border-red-200 text-[#dd0000] text-xs font-semibold uppercase tracking-wider mb-2.5">
          <span>Catálogo Técnico Oficial</span>
        </div>
        
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 mb-2">
          Equipos y Soluciones en <span class="text-[#dd0000]">Fluidos</span>
        </h1>
        
        <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
          Consulta especificaciones técnicas, diámetros disponibles y normas de fabricación para cada línea de suministro industrial y saneamiento.
        </p>
      </div>

      <!-- Buscador interno en página y resumen de filtros -->
      <div class="mt-6 max-w-xl">
        <div class="relative">
          <input 
            type="text" 
            id="catalog-search" 
            placeholder="Buscar por nombre, código o norma técnica..." 
            class="w-full bg-white text-slate-900 placeholder-slate-400 text-xs sm:text-sm pl-10 pr-4 py-2.5 rounded-xl border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-[#dd0000] shadow-2xs"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

    </div>
  </section>

  <!-- Filtro por Categorías y Grid de Productos -->
  <section class="py-10 sm:py-14 bg-neutral-50/70 border-b border-neutral-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Tabs de Categorías con Scroll Horizontal en móvil -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar" id="catalog-category-tabs">
        {categoryTabs.map((cat, idx) => (
          <button
            type="button"
            data-category-target={cat.id}
            class={`catalog-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-all duration-200 cursor-pointer ${
              idx === 0 
                ? "bg-[#dd0000] text-white shadow-sm" 
                : "bg-white text-neutral-700 hover:bg-neutral-200/80 border border-neutral-200"
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Contador de Resultados -->
      <div class="flex items-center justify-between text-xs text-neutral-500 mb-6 font-medium">
        <span>Mostrando productos certificados Valvoline Perú</span>
        <span id="product-count" class="font-bold text-neutral-800">{products.length} productos</span>
      </div>

      <!-- Grid de Productos -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="products-catalog-grid">
        {products.map((item) => (
          <div 
            class="product-card group bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-xl hover:border-[#dd0000] transition-all duration-300 flex flex-col justify-between"
            data-cat={item.category}
            data-search={`${item.name} ${item.code} ${item.norm} ${item.categoryName} ${item.specs}`.toLowerCase()}
          >
            <!-- Cabecera de Tarjeta y Foto -->
            <div class="relative bg-neutral-100/60 p-6 flex flex-col items-center justify-center min-h-[220px] border-b border-neutral-100">
              <span class="absolute top-4 left-4 text-[10px] font-bold uppercase tracking-wider text-slate-500 bg-white/90 px-2 py-0.5 rounded border border-neutral-200">
                {item.code}
              </span>
              
              <span class="absolute top-4 right-4 text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200/70">
                Stock Lima
              </span>

              <div class="w-full h-44 flex items-center justify-center overflow-hidden my-1">
                <img 
                  src={item.image} 
                  alt={item.name}
                  class="max-h-full max-w-full object-contain group-hover:scale-108 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Información Técnica del Producto -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-[#dd0000] block mb-1">
                  {item.categoryName}
                </span>

                <h3 class="text-xs sm:text-sm font-bold text-slate-800 tracking-tight leading-snug group-hover:text-[#dd0000] transition-colors mb-2">
                  {item.name}
                </h3>

                <p class="text-[11px] text-neutral-600 font-normal leading-relaxed mb-3">
                  {item.specs}
                </p>

                <!-- Norma Técnica -->
                <div class="bg-neutral-50 p-2 rounded-lg border border-neutral-200/70 text-[11px] text-neutral-700 mb-3">
                  <span class="block font-semibold text-neutral-800 mb-0.5">Normas Aplicables:</span>
                  <span class="text-neutral-500 font-normal">{item.norm}</span>
                </div>

                <!-- Diámetros Disponibles -->
                <div class="mb-4">
                  <span class="block text-[10px] font-medium text-neutral-400 uppercase tracking-wider mb-1">
                    Diámetros / Medidas:
                  </span>
                  <div class="flex flex-wrap gap-1">
                    {item.diameters.map((d) => (
                      <span class="px-1.5 py-0.5 rounded bg-neutral-100 text-[10px] font-medium text-neutral-700 border border-neutral-200">
                        {d}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Botones de Acción -->
              <div class="pt-3 border-t border-neutral-100 flex flex-col sm:flex-row gap-2">
                <a
                  href={`https://wa.me/51926961256?text=${encodeURIComponent(`Hola Valvoline Perú, deseo solicitar cotización técnica del producto: ${item.name} (${item.code})`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 px-3.5 py-2 bg-[#dd0000] hover:bg-[#b80000] text-white font-medium text-xs tracking-normal rounded-lg transition-colors flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  <span>Cotizar</span>
                </a>

                <a
                  href="/contacto"
                  class="px-3.5 py-2 bg-neutral-100 hover:bg-neutral-200 text-neutral-600 font-medium text-xs tracking-normal rounded-lg transition-colors flex items-center justify-center cursor-pointer"
                >
                  <span>Ficha</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Mensaje cuando no hay resultados en búsqueda -->
      <div id="no-results-message" class="hidden py-16 text-center">
        <p class="text-base font-bold text-neutral-800">No se encontraron productos que coincidan con la búsqueda.</p>
        <p class="text-xs text-neutral-500 mt-1">Intenta con otro término o selecciona una categoría diferente.</p>
      </div>

    </div>
  </section>
</Layout>

<script>
  function setupCatalogInteractivity() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.catalog-tab-btn');
    const productCards = document.querySelectorAll<HTMLElement>('.product-card');
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const countBadge = document.getElementById('product-count');
    const noResultsMsg = document.getElementById('no-results-message');

    let activeCategory = 'todas';
    let searchQuery = '';

    // 1. Leer parámetros de URL (?categoria=... & ?q=...)
    const params = new URLSearchParams(window.location.search);
    const categoryFromUrl = params.get('categoria');
    const queryFromUrl = params.get('q');

    if (categoryFromUrl) {
      activeCategory = categoryFromUrl;
    }
    if (queryFromUrl && searchInput) {
      searchQuery = queryFromUrl.toLowerCase().trim();
      searchInput.value = queryFromUrl;
    }

    function applyFilters() {
      let visibleCount = 0;

      productCards.forEach(card => {
        const cardCategory = card.dataset.cat || '';
        const searchContent = card.dataset.search || '';

        const matchesCat = activeCategory === 'todas' || cardCategory === activeCategory;
        const matchesSearch = !searchQuery || searchContent.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Actualizar contador
      if (countBadge) {
        countBadge.textContent = `${visibleCount} productos`;
      }

      // Mensaje de sin resultados
      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }

      // Actualizar estilos activos de botones
      tabButtons.forEach(btn => {
        const catTarget = btn.dataset.categoryTarget;
        if (catTarget === activeCategory) {
          btn.classList.remove('bg-white', 'text-neutral-700', 'border', 'border-neutral-200');
          btn.classList.add('bg-[#dd0000]', 'text-white', 'shadow-sm');
        } else {
          btn.classList.remove('bg-[#dd0000]', 'text-white', 'shadow-sm');
          btn.classList.add('bg-white', 'text-neutral-700', 'border', 'border-neutral-200');
        }
      });
    }

    // Event listeners para tabs
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.categoryTarget || 'todas';
        applyFilters();
      });
    });

    // Event listener para buscador
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        applyFilters();
      });
    }

    // Aplicar filtros iniciales
    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCatalogInteractivity);
  } else {
    setupCatalogInteractivity();
  }
</script>
